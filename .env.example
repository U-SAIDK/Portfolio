# Used by `netlify dev` for local testing of netlify/functions/contact.js.
# Copy this file to `.env` and fill in real values — never commit `.env`.
#
# In production these same variable names must be set separately under
# Site settings -> Environment variables in the Netlify dashboard;
# a committed .env file is NOT read by deployed Netlify Functions.

# Gmail address used to send contact-form emails.
SMTP_USER=your-address@gmail.com

# Gmail App Password (not your normal password) — generate one at
# https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password

# Where contact-form messages should be delivered. Defaults to SMTP_USER.
MAIL_TO=your-address@gmail.com

# Secret key for your Cloudflare Turnstile widget (server-side only).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Portfolio assistant (robot chat) — all optional ─────────────────────
# Without ANTHROPIC_API_KEY the assistant still works: it answers by
# quoting the passages it retrieves from the knowledge base. With a key
# it writes a natural-language answer grounded in those passages.
# Create a key at https://console.anthropic.com/ and set a monthly spend
# limit on it — the endpoint is public.
ANTHROPIC_API_KEY=

# Model used for answers. Defaults to claude-opus-5-5.
# CHAT_MODEL=claude-opus-5-5

# Max generated answers per function instance per day (default 300).
# Beyond it the assistant falls back to quoting passages.
# CHAT_DAILY_LIMIT=300
